datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ASHA_WORKER
  DOCTOR
  PHC_ADMIN
}

enum Severity {
  LOW_GREEN
  MODERATE_YELLOW
  CRITICAL_RED
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  COMPLETED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ASHA_WORKER)
  phcCenter String
  createdAt DateTime @default(now())
}

model Patient {
  id            String         @id @default(uuid())
  abhaId        String         @unique // 14-digit ABDM Mock ID (e.g. 91-1234-5678-9012)
  fullName      String
  age           Int
  gender        String
  phone         String?
  village       String
  isHighRisk    Boolean        @default(false)
  category      String?        // "Maternal", "Infant", "Diabetic", "Hypertensive"
  triageRecords TriageRecord[]
  referrals     Referral[]
  createdAt     DateTime       @default(now())
}

model TriageRecord {
  id                String    @id @default(uuid())
  patientId         String
  patient           Patient   @relation(fields: [patientId], references: [id])
  ashaWorkerId      String
  symptomsRaw       String
  aiSummary         String?
  severity          Severity  @default(LOW_GREEN)
  vitals            Json      // { bp: "120/80", pulse: 78, spO2: 98, temp: 99.1 }
  syncedFromOffline Boolean   @default(false)
  createdAt         DateTime  @default(now())
}

model Referral {
  id           String         @id @default(uuid())
  patientId    String
  patient      Patient        @relation(fields: [patientId], references: [id])
  fromFacility String
  toFacility   String
  reason       String
  status       ReferralStatus @default(PENDING)
  createdAt    DateTime       @default(now())
}

model MedicineInventory {
  id           String   @id @default(uuid())
  facility     String
  name         String
  currentStock Int
  minThreshold Int
  unit         String
  updatedAt    DateTime @updatedAt
}